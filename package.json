{
  "name": "mern",
  "description": "CRUD in MongoDB, Express, React/Hooks, Node",
  "main": "index.js",
  "scripts": {
    "test": "eslint --fix **/src/",
    "lint:playwright": "npm exec --yes --package=eslint@9 -c \"eslint --config playwright/eslint.config.mjs playwright/tests/**/*.ts\"",
    "test:all": "playwright test --config=playwright/playwright.config.ts",
    "test:smoke": "playwright test --config=playwright/playwright.config.ts --tag=@Smoke",
    "test:chromium": "playwright test --config=playwright/playwright.config.ts --project=\"Desktop Chrome\"",
    "test:mobile": "playwright test --config=playwright/playwright.config.ts --project=\"Mobile Chrome\"",
    "test:login": "playwright test --config=playwright/playwright.config.ts --project=\"Desktop Chrome\" --test-only login.spec.ts",
    "test:registration": "playwright test --config=playwright/playwright.config.ts --project=\"Desktop Chrome\" --test-only registration.spec.ts",
    "test:account": "playwright test --config=playwright/playwright.config.ts --project=\"Desktop Chrome\" --test-only account.spec.ts",
    "precommit": "npm test",
    "prepush": "npm test",
    "heroku:add": "heroku git:remote -a",
    "deploy:heroku": "git subtree push --prefix server heroku master"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=6.0.0"
  },
  "engineStrict": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amazingandyyy/mern.git"
  },
  "keywords": [
    "react"
  ],
  "author": "Amazingandyyy <amazingandyyy@gmail.com> (Andy Chen)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/amazingandyyy/mern/issues"
  },
  "homepage": "https://github.com/amazingandyyy/mern#readme",
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.2.1",
    "eslint": "^4.14.0",
    "eslint-config-logux": "^17.0.0",
    "eslint-config-standard": "^10.2.1",
    "eslint-plugin-es5": "^1.1.0",
    "eslint-plugin-import": "^2.8.0",
    "eslint-plugin-jest": "^21.5.0",
    "eslint-plugin-node": "^5.2.1",
    "eslint-plugin-promise": "^3.6.0",
    "eslint-plugin-react": "^7.5.1",
    "eslint-plugin-security": "^1.4.0",
    "eslint-plugin-standard": "^3.0.1",
    "husky": "^0.14.3",
    "nodemon": "^1.17.5",
    "serve": "^14.2.0",
    "wait-on": "^7.2.0"
  }
}
